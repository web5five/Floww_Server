# Copy to .env for local Compose and export values in your shell for the Java app.
FLOWW_DB_PASSWORD=replace-with-a-local-only-password
FLOWW_DB_PORT=55433
FLOWW_DEV_TOKEN_ALICE=replace-with-a-long-local-only-token
FLOWW_DEV_TOKEN_BOB=replace-with-another-long-local-only-token
# KILN_API_KEY is omitted until the controller supplies it securely.
# Issue #22: Access Token(JWT) HS256 서명키. 32바이트 이상 무작위 문자열.
JWT_SIGNING_KEY=replace-with-a-long-local-jwt-signing-key
# Issue #34/#35: task settlement asset (defaults: Sepolia fUSDC, decimals 6). Override only for another agreed token.
# FLOWW_TASK_CHAIN_ID=11155111
# FLOWW_TASK_TOKEN_ADDRESS=0x84B494ff145a545D286321691a9B4Febe6947D6A
# FLOWW_TASK_TOKEN_DECIMALS=6
# Issue #33: pharmacy payout addresses in the trusted registry. Defaults are keyless placeholders;
# set real testnet addresses from the chain owner before any payment test.
# FLOWW_PHARMACY_A_RECIPIENT=0x...
# FLOWW_PHARMACY_B_RECIPIENT=0x...
# FLOWW_PHARMACY_C_RECIPIENT=0x...
