FROM eclipse-temurin:21-jdk AS build
WORKDIR /build

# The Maven wrapper pins the ZIP checksum and needs unzip to use that archive.
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*

COPY mvnw pom.xml ./
COPY .mvn .mvn
COPY src src
COPY examples/wallet-signin examples/wallet-signin
RUN ./mvnw -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/target/floww-server-0.1.0.jar /app/server.jar
COPY --chmod=755 scripts/vercel-entrypoint.sh /app/entrypoint.sh
ENV SPRING_PROFILES_ACTIVE=vercel
ENV PORT=8080
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
